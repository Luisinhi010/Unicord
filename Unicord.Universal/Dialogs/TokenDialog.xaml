<ContentDialog
    x:Uid="/Dialogs/TokenDialog"
    x:Class="Unicord.Universal.Dialogs.TokenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Unicord.Universal.Controls"
    mc:Ignorable="d"
    PrimaryButtonText="PrimaryButtonText"
    CloseButtonText="CloseButtonText"
    Style="{ThemeResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    CloseButtonClick="ContentDialog_CloseButtonClick">

    <Grid MaxWidth="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   x:Uid="/Dialogs/TokenTitle"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="/Dialogs/TokenTitle"/>

        <controls:MarkdownTextBlock x:Name="SubtitleTextBlock"
                                    x:Uid="/Dialogs/TokenSubtitle"
                                    Grid.Row="1"
                                    Text="/Dialogs/TokenSubtitle"/>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.72"
                   Text="Security note: this credential grants broad account access. Unicord will store it only in Windows Credential Locker. Do not save it in a text file or share it with anyone."/>

        <PasswordBox x:Name="TokenTextBox"
                     Margin="0,12,0,0"
                     Grid.Row="3"/>
    </Grid>
</ContentDialog>
